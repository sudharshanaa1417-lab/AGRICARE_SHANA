# ==========================================
# AGRICARE BACKEND CONFIGURATION (.env)
# ==========================================

# Port and Environment
PORT=8000
ENVIRONMENT=development

# Database URL: SQLite default or PostgreSQL on Supabase/Render
# Example Postgres: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./agricare.db

# API Key for Arduino NodeMCU ESP8266 Authentication (Header: X-API-Key)
DEVICE_API_KEY=agricare_live_secret_key_2026

# AI Crop Disease Detection Model Configuration
# When providing your own trained model endpoint, specify it here
AI_MODEL_ENDPOINT=
AI_MODEL_VERSION=AgriCare-Inference-v2.5
AI_MODEL_API_KEY=

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://agricare.vercel.app

# Optional OpenWeatherMap API Key for live agricultural weather
WEATHER_API_KEY=
